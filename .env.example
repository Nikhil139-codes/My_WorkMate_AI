# WorkMate AI - Environment Configuration Template
# Duplicate this file to .env and fill in your values

# Database (MongoDB Atlas / MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="workmate_ai"

# Authentication
# Run `openssl rand -base64 32` or use a secure random string (minimum 32 characters)
AUTH_SECRET="workmate_ai_super_secret_jwt_encryption_key_32_bytes_min"
AUTH_COOKIE_NAME="workmate_auth_token"

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=""
# Recommended production model: openai/gpt-oss-120b or llama-3.1-8b-instant
GROQ_MODEL="openai/gpt-oss-120b"

# Application URL
APP_URL="http://localhost:3000"

# Storage Configuration (Local storage for dev, extensible to S3/GCS)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="25"

# Document Embeddings & Vector Search (Phase 2)
# Provider options: "local" (built-in deterministic 384-dim semantic embeddings, zero setup) or "openai"
EMBEDDING_PROVIDER="local"
# If EMBEDDING_PROVIDER="openai", configure OPENAI_API_KEY and model
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# MongoDB Atlas Vector Search Index Name (Optional - automatically falls back to workspace-scoped semantic similarity if not configured)
MONGODB_VECTOR_INDEX="vector_index"
