// WorkMate AI - Prisma Schema
// PostgreSQL Relational Application Database

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       WorkspaceMembership[]
  conversations     AIConversation[]
  activityLogs      ActivityLog[]
  documentsUploaded Document[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   WorkspaceMembership[]
  documents     Document[]
  conversations AIConversation[]
  activityLogs  ActivityLog[]
  tasks         Task[]
  workflows     Workflow[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Document {
  id               String   @id @default(cuid())
  workspaceId      String
  uploadedByUserId String?
  originalFilename String
  mimeType         String
  fileSize         Int
  storageKey       String
  processingStatus String   @default("PENDING") // PENDING, PROCESSING, READY, FAILED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([uploadedByUserId])
  @@map("documents")
}

model AIConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String   @default("New Conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([workspaceId])
  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user, assistant, system
  content        String
  modelId        String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model ActivityLog {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String   // e.g. "USER_REGISTERED", "CHAT_MESSAGE_SENT", "DOCUMENT_UPLOADED"
  resourceType String   // e.g. "CONVERSATION", "WORKSPACE", "DOCUMENT"
  resourceId   String?
  metadata     String?  // Serialized JSON metadata
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@map("activity_logs")
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("tasks")
}

model Workflow {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED
  runsCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workflows")
}
